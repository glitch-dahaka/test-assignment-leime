{% set names = [domain.name] + (domain.aliases | default([])) %}
{% set auth = domain.basic_auth | default({}) %}
{% set auth_enabled = auth.enabled | default(false) | bool %}
{% set https_port = nginx_https_port | int %}
server {
    listen 80;
{% if nginx_listen_ipv6 | bool %}
    listen [::]:80;
{% endif %}
    server_name {{ names | join(' ') }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        return 301 https://$host{% if https_port != 443 %}:{{ https_port }}{% endif %}$request_uri;
    }
}

server {
    listen 443 ssl;
{% if nginx_listen_ipv6 | bool %}
    listen [::]:443 ssl;
{% endif %}
    http2 on;
    server_name {{ names | join(' ') }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain.name }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain.name }}/privkey.pem;

    index index.html;
{% if auth_enabled %}

    auth_basic "{{ auth.realm | default('Restricted') }}";
    auth_basic_user_file /etc/nginx/htpasswd/{{ domain.name }};
{% endif %}

    location ^~ /.well-known/acme-challenge/ {
        auth_basic off;
        root /var/www/certbot;
        default_type text/plain;
    }

    location = /robots.txt {
        auth_basic off;
        root /var/www/robots/{{ domain.name }};
        default_type text/plain;
    }
{% for loc in domain.locations | default([]) %}

    location {{ loc.path }} {
{% if auth_enabled and not (loc.basic_auth | default(true) | bool) %}
        auth_basic off;
{% endif %}
{% if loc.proxy_pass is defined %}
        proxy_pass {{ loc.proxy_pass }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
{% if loc.websocket | default(false) | bool %}
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
{% endif %}
{% elif loc.alias is defined %}
        alias {{ loc.alias }};
{% elif loc.root is defined %}
        root {{ loc.root }};
{% if loc.index is defined %}
        index {{ loc.index }};
{% endif %}
{% elif loc.return is defined %}
{% if auth_enabled and (loc.basic_auth | default(true) | bool) %}
        try_files /__nginx_auth_gate__ @return_{{ domain.name | replace('.', '_') | replace('-', '_') }}_{{ loop.index }};
{% else %}
        default_type text/plain;
        return {{ loc.return }};
{% endif %}
{% endif %}
    }
{% endfor %}
{% for loc in domain.locations | default([]) %}
{% if auth_enabled and (loc.basic_auth | default(true) | bool) and loc.return is defined %}

    location @return_{{ domain.name | replace('.', '_') | replace('-', '_') }}_{{ loop.index }} {
        default_type text/plain;
        return {{ loc.return }};
    }
{% endif %}
{% endfor %}
}
