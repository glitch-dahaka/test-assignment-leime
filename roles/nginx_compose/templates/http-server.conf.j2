{% set names = [domain.name] + (domain.aliases | default([])) %}
server {
    listen 80;
{% if nginx_listen_ipv6 | bool %}
    listen [::]:80;
{% endif %}
    server_name {{ names | join(' ') }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type text/plain;
    }

    location / {
        default_type text/plain;
        return 404 'certificate pending';
    }
}
